# Local/container web server: serves the SPA and proxies /api to the API container.
# Staging/production TLS, on-demand TLS and security headers come with ROADMAP M0-A9 / M5b-A3.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
