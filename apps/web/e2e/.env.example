# Playwright test settings (NAMING §10, test only — never read by the app).
# Copy to apps/web/e2e/.env (git-ignored), fill in the staff values, then run once: make seed ARGS=--e2e-staff
# Never put real or shared passwords here; these values exist only for the local test staff user.

# Web app under test. Empty = http://localhost:5173 (make dev).
E2E_BASE_URL=

# Mailpit API, where the test reads the invitation link. Empty = http://localhost:8025 (make up).
E2E_MAILPIT_URL=

# Staff login of the test: your own test address; make seed ARGS=--e2e-staff creates or updates this staff user.
E2E_STAFF_EMAIL=

# Password of that staff user, 12–128 characters.
E2E_STAFF_PASSWORD=

# Base32 TOTP secret (A-Z, 2-7). Generate in apps/api: uv run python -c "import pyotp; print(pyotp.random_base32())"
E2E_STAFF_TOTP_SECRET=
